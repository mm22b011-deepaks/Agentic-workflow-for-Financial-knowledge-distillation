# Run ./setup.sh init to configure these values securely.
# The dedicated launcher loads .env without overriding exported values.
# Never commit values or put them in command arguments.

# Required. Free OpenRouter models only (every model id must end in ":free").
OPENROUTER_API_KEY=

# Required. SEC asks that automated requests identify a real contact.
# Format: "app-name contact@example.com"
SEC_USER_AGENT=

# Optional. Overrides paths.data_dir when set.
# DATA_DIR=data
