{
  "$defs": {
    "GraphLink": {
      "additionalProperties": false,
      "properties": {
        "source_port": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Port"
        },
        "target_port": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Port"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "source",
        "target"
      ],
      "title": "GraphLink",
      "type": "object"
    },
    "GraphPoint": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z-]*$",
          "title": "Id",
          "type": "string"
        },
        "x": {
          "maximum": 100000,
          "minimum": -100000,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 100000,
          "minimum": -100000,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "id",
        "x",
        "y"
      ],
      "title": "GraphPoint",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "v1",
      "default": "v1",
      "title": "Version",
      "type": "string"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/GraphPoint"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Nodes",
      "type": "array"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/GraphLink"
      },
      "maxItems": 200,
      "title": "Edges",
      "type": "array"
    }
  },
  "required": [
    "nodes",
    "edges"
  ],
  "title": "GraphDocument",
  "type": "object"
}
